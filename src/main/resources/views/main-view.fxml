<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.travis.customclicker.controller.MainController"
           prefWidth="1200" prefHeight="800"
           styleClass="window-border"
           stylesheets="@../css/styles.css">

    <fx:define>
        <ToggleGroup fx:id="timingGroup"/>
        <ToggleGroup fx:id="fixedGroup"/>
        <ToggleGroup fx:id="targetGroup"/>
        <ToggleGroup fx:id="accentGroup"/>
    </fx:define>

    <BorderPane styleClass="app-root">
        <!-- SIDEBAR -->
        <left>
            <VBox prefWidth="250" spacing="12" styleClass="sidebar">
                <padding><Insets top="28" right="18" bottom="24" left="18"/></padding>

                <StackPane styleClass="about-app-icon">
                    <FontIcon iconLiteral="fth-mouse-pointer" iconSize="52" iconColor="white"/>
                </StackPane>
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Label text="Custom" styleClass="sidebar-title"/>
                    <Label text="Clicker" styleClass="sidebar-title, title-accent"/>
                </HBox>
                <Region prefHeight="28"/>

                <Button fx:id="clickerNavButton" text="Clicker" onAction="#handleShowClicker"
                        maxWidth="Infinity" graphicTextGap="14" styleClass="nav-active">
                    <graphic>
                        <FontIcon iconLiteral="fth-home" iconSize="22"/>
                    </graphic>
                </Button>

                <Button fx:id="profilesNavButton" text="Profiles" onAction="#handleShowProfiles"
                        maxWidth="Infinity" graphicTextGap="14" styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-layers" iconSize="22"/>
                    </graphic>
                </Button>

                <Button fx:id="settingsNavButton" text="Settings" onAction="#handleShowSettings"
                        maxWidth="Infinity" graphicTextGap="14" styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-settings" iconSize="22"/>
                    </graphic>
                </Button>

                <Button fx:id="aboutNavButton" text="About" onAction="#handleShowAbout"
                        maxWidth="Infinity" graphicTextGap="14" styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-info" iconSize="22"/>
                    </graphic>
                </Button>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
        </left>

        <!-- MAIN CONTENT -->
        <center>
            <VBox spacing="16" styleClass="main-content">
                <padding><Insets top="16" right="20" bottom="18" left="20"/></padding>

                <!-- SHARED TITLE BAR -->
                <HBox alignment="CENTER_LEFT" prefHeight="46"
                    onMousePressed="#handleWindowPressed" onMouseDragged="#handleWindowDragged">

                    <HBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="Custom" styleClass="page-title"/>
                        <Label text="Clicker" styleClass="page-title, title-accent"/>
                    </HBox>
                    <Region prefWidth="16"/>

                    <HBox fx:id="statusPill" alignment="CENTER" spacing="6" styleClass="status-pill">
                        <Label fx:id="statusDot" text="●" styleClass="status-dot"/>
                        <Label fx:id="statusText" text="Idle" styleClass="status-text"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="−" onAction="#handleMinimize" styleClass="window-button"/>
                    <Button text="×" onAction="#handleClose" styleClass="window-close"/>
                </HBox>

                <!-- PAGE CONTAINER -->
                <StackPane VBox.vgrow="ALWAYS">

                    <!-- CLICKER PAGE -->
                    <VBox fx:id="clickerPage" spacing="16" maxWidth="Infinity">

                        <!-- TIMING -->
                        <VBox spacing="14" styleClass="card">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane styleClass="section-icon">
                                    <FontIcon iconLiteral="fth-clock" iconSize="25" iconColor="#17dc7b"/>
                                </StackPane>

                                <VBox spacing="2">
                                    <Label text="Timing" styleClass="card-title"/>
                                    <Label text="Control how fast and when to click." styleClass="muted"/>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER" styleClass="tab-bar">
                                <ToggleButton fx:id="fixedTimingButton" text="Fixed" selected="true"
                                            toggleGroup="$timingGroup" maxWidth="Infinity"
                                            HBox.hgrow="ALWAYS" styleClass="tab"/>

                                <Region styleClass="tab-divider"/>

                                <ToggleButton fx:id="randomCpsButton" text="Random CPS"
                                            toggleGroup="$timingGroup" maxWidth="Infinity"
                                            HBox.hgrow="ALWAYS" styleClass="tab"/>

                                <Region styleClass="tab-divider"/>

                                <ToggleButton fx:id="randomIntervalButton" text="Random Interval"
                                            toggleGroup="$timingGroup" maxWidth="Infinity"
                                            HBox.hgrow="ALWAYS" styleClass="tab"/>
                            </HBox>

                            <StackPane prefHeight="135" minHeight="135" maxHeight="135">

                                <!-- FIXED -->
                                <GridPane fx:id="fixedPane" hgap="28" maxWidth="Infinity">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="49" hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="1" prefWidth="1" maxWidth="1"/>
                                        <ColumnConstraints percentWidth="49" hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <VBox GridPane.columnIndex="0" spacing="8" maxWidth="Infinity">
                                        <HBox styleClass="tab-bar">
                                            <ToggleButton fx:id="fixedIntervalButton" text="Interval" selected="true"
                                                        toggleGroup="$fixedGroup" maxWidth="Infinity"
                                                        HBox.hgrow="ALWAYS" styleClass="tab"/>

                                            <ToggleButton fx:id="fixedCpsButton" text="CPS"
                                                        toggleGroup="$fixedGroup" maxWidth="Infinity"
                                                        HBox.hgrow="ALWAYS" styleClass="tab"/>
                                        </HBox>

                                        <Label fx:id="fixedValueLabel" text="Interval (ms)" styleClass="field-label"/>
                                        <Spinner fx:id="fixedValueSpinner" editable="true" maxWidth="Infinity"/>
                                        <Label fx:id="fixedHelperLabel"
                                            text="Use a constant delay between clicks." styleClass="muted"/>
                                    </VBox>

                                    <Region GridPane.columnIndex="1"
                                        styleClass="timing-vertical-divider"/>

                                    <VBox GridPane.columnIndex="2" spacing="8" maxWidth="Infinity">

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <StackPane styleClass="section-icon-small">
                                                <FontIcon iconLiteral="fth-activity" iconSize="25" iconColor="#17dc7b"/>
                                            </StackPane>

                                            <Label fx:id="fixedEquivalentTitle"
                                                text="Equivalent Speed"
                                                styleClass="field-label"/>
                                        </HBox>

                                        <Label fx:id="fixedEquivalentValue"
                                            text="10 CPS"
                                            maxWidth="Infinity"
                                            styleClass="display-field"/>

                                        <Label fx:id="fixedEquivalentHelper"
                                            text="Equivalent clicking speed."
                                            styleClass="muted"/>
                                    </VBox>
                                </GridPane>

                                <!-- RANDOM CPS -->
                                <GridPane fx:id="randomCpsPane" hgap="28" maxWidth="Infinity"
                                        visible="false" managed="false">

                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="49" hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="1" prefWidth="1" maxWidth="1"/>
                                        <ColumnConstraints percentWidth="49" hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <!-- LEFT SIDE -->
                                    <VBox GridPane.columnIndex="0" spacing="8" maxWidth="Infinity">
                                        <HBox spacing="12">
                                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                <Label text="Minimum CPS" styleClass="field-label"/>
                                                <Spinner fx:id="minCpsSpinner" editable="true" maxWidth="Infinity"/>
                                            </VBox>

                                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                <Label text="Maximum CPS" styleClass="field-label"/>
                                                <Spinner fx:id="maxCpsSpinner" editable="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </HBox>

                                        <Label text="Clicks are randomly chosen within this CPS range."
                                            styleClass="muted"/>
                                    </VBox>

                                    <!-- DIVIDER -->
                                    <Region GridPane.columnIndex="1"
                                            styleClass="timing-vertical-divider"/>

                                    <!-- RIGHT SIDE -->
                                    <VBox GridPane.columnIndex="2" spacing="8" maxWidth="Infinity">

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <StackPane styleClass="section-icon-small">
                                                <FontIcon iconLiteral="fth-activity" iconSize="25" iconColor="#17dc7b"/>
                                            </StackPane>

                                            <Label text="Equivalent Interval" styleClass="field-label"/>
                                        </HBox>

                                        <Label fx:id="randomCpsEquivalentValue"
                                            text="≈ 100 – 200 ms"
                                            maxWidth="Infinity"
                                            styleClass="display-field"/>

                                        <Label text="Equivalent delay range between clicks."
                                            styleClass="muted"/>
                                    </VBox>
                                </GridPane>

                                <!-- RANDOM INTERVAL -->
                                <GridPane fx:id="randomIntervalPane" hgap="28" maxWidth="Infinity"
                                        visible="false" managed="false">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="49" hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="1" prefWidth="1" maxWidth="1"/>
                                        <ColumnConstraints percentWidth="49" hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <VBox GridPane.columnIndex="0" spacing="8" maxWidth="Infinity">
                                        <HBox spacing="12">
                                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                <Label text="Minimum Interval (ms)" styleClass="field-label"/>
                                                <Spinner fx:id="minIntervalSpinner" editable="true" maxWidth="Infinity"/>
                                            </VBox>

                                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                <Label text="Maximum Interval (ms)" styleClass="field-label"/>
                                                <Spinner fx:id="maxIntervalSpinner" editable="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </HBox>

                                        <Label text="Each delay is randomly chosen within this interval range."
                                            styleClass="muted"/>
                                    </VBox>

                                    <Region GridPane.columnIndex="1"
                                        styleClass="timing-vertical-divider"/>

                                    <VBox GridPane.columnIndex="2" spacing="8" maxWidth="Infinity">

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <StackPane styleClass="section-icon-small">
                                                <FontIcon iconLiteral="fth-activity" iconSize="25" iconColor="#17dc7b"/>
                                            </StackPane>

                                            <Label text="Equivalent Speed" styleClass="field-label"/>
                                        </HBox>

                                        <Label fx:id="randomIntervalEquivalentValue"
                                            text="≈ 5 – 10 CPS"
                                            maxWidth="Infinity"
                                            styleClass="display-field"/>

                                        <Label text="Equivalent clicking speed for this interval range."
                                            styleClass="muted"/>
                                    </VBox>
                                </GridPane>

                            </StackPane>
                        </VBox>

                        <!-- CLICK BEHAVIOR + TARGET -->
                        <GridPane hgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" minWidth="0"/>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" minWidth="0"/>
                            </columnConstraints>

                            <VBox GridPane.columnIndex="0" spacing="14"
                                maxWidth="Infinity" styleClass="card, half-card">

                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="section-icon">
                                        <FontIcon iconLiteral="fth-mouse-pointer" iconSize="25" iconColor="#17dc7b"/>
                                    </StackPane>

                                    <VBox spacing="2">
                                        <Label text="Click Behavior" styleClass="card-title"/>
                                        <Label text="Choose what kind of clicks to perform." styleClass="muted"/>
                                    </VBox>
                                </HBox>

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Mouse Button" prefWidth="125" styleClass="field-label"/>
                                    <ComboBox fx:id="mouseButtonCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Click Type" prefWidth="125" styleClass="field-label"/>
                                    <ComboBox fx:id="clickTypeCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Repeat" prefWidth="125" styleClass="field-label"/>
                                    <ComboBox fx:id="repeatCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox fx:id="repeatAmountRow" alignment="CENTER_LEFT" visible="false" managed="false">
                                    <Label text="Click Amount" prefWidth="125" styleClass="field-label"/>
                                    <Spinner fx:id="repeatAmountSpinner" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>

                            <VBox GridPane.columnIndex="1" spacing="12"
                                maxWidth="Infinity" styleClass="card, half-card">

                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="section-icon">
                                        <FontIcon iconLiteral="fth-target" iconSize="25" iconColor="#17dc7b"/>
                                    </StackPane>

                                    <VBox spacing="2">
                                        <Label text="Click Target" styleClass="card-title"/>
                                        <Label text="Where to click on the screen." styleClass="muted"/>
                                    </VBox>
                                </HBox>

                                <RadioButton fx:id="followCursorButton" text="Follow Cursor" selected="true"
                                    toggleGroup="$targetGroup" prefHeight="24"/>

                                <RadioButton fx:id="fixedPositionButton" text="Fixed Position"
                                    toggleGroup="$targetGroup" prefHeight="24"/>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="X" styleClass="field-label"/>
                                    <Spinner fx:id="xSpinner" editable="true"
                                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>

                                    <Label text="Y" styleClass="field-label"/>
                                    <Spinner fx:id="ySpinner" editable="true"
                                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <Button text="Pick from screen"
                                        maxWidth="Infinity" styleClass="secondary-button"/>
                            </VBox>
                        </GridPane>

                        <!-- PROFILE SELECTOR -->
                        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card, profile-card">
                            <StackPane styleClass="section-icon-small">
                                <FontIcon iconLiteral="fth-layers" iconSize="25" iconColor="#17dc7b"/>
                            </StackPane>

                            <Label text="Profile" styleClass="card-title"/>
                            <ComboBox fx:id="profileCombo" prefWidth="350"/>
                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="New Profile" onAction="#handleNewProfile"
                                    graphicTextGap="8" styleClass="secondary-button">
                                <graphic>
                                    <FontIcon iconLiteral="fth-plus" iconSize="16" iconColor="#17dc7b"/>
                                </graphic>
                            </Button>
                        </HBox>

                        <Button fx:id="startButton" maxWidth="Infinity" prefHeight="68"
                                onAction="#handleStart" styleClass="start-button">

                            <graphic>
                                <HBox alignment="CENTER" spacing="14">

                                    <SVGPath fx:id="startIcon"
                                            content="M8 5v14l11-7z"
                                            fill="white"
                                            scaleX="1.4"
                                            scaleY="1.4"/>

                                    <Label fx:id="startButtonText"
                                        text="Start Clicking"
                                        styleClass="start-button-text"/>

                                    <Label text="F6" styleClass="start-hotkey"/>

                                </HBox>
                            </graphic>
                        </Button>

                        <Label text="Left click  •  Fixed 100 ms  •  Follow cursor"
                            maxWidth="Infinity" alignment="CENTER" styleClass="summary"/>

                    </VBox>

                    <!-- PROFILES PAGE -->
                    <VBox fx:id="profilesPage" spacing="14"
                        visible="false" managed="false" maxWidth="Infinity">

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="3">
                                <Label text="Profiles" styleClass="profiles-heading"/>
                                <Label text="Save and manage your clicker configurations." styleClass="muted"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="New Profile" onAction="#handleNewProfile"
                                    graphicTextGap="8" styleClass="profile-primary-button">
                                <graphic>
                                    <FontIcon iconLiteral="fth-plus" iconSize="16" iconColor="#04140c"/>
                                </graphic>
                            </Button>
                        </HBox>

                        <GridPane hgap="14" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="40" hgrow="ALWAYS" minWidth="0"/>
                                <ColumnConstraints percentWidth="60" hgrow="ALWAYS" minWidth="0"/>
                            </columnConstraints>

                            <!-- SAVED PROFILES -->
                            <VBox GridPane.columnIndex="0" spacing="14"
                                styleClass="card, profiles-panel" maxWidth="Infinity">

                                <VBox spacing="3">
                                    <Label text="Saved Profiles" styleClass="card-title"/>
                                    <Label text="Select a profile to edit or use." styleClass="muted"/>
                                </VBox>

                                <Label fx:id="profileCountLabel" text="1 profile" styleClass="profile-count"/>

                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                            hbarPolicy="NEVER" styleClass="profile-scroll">
                                    <content>
                                        <VBox fx:id="profileList" spacing="10" maxWidth="Infinity"/>
                                    </content>
                                </ScrollPane>
                            </VBox>

                            <!-- PROFILE DETAILS -->
                            <VBox GridPane.columnIndex="1" spacing="12"
                                styleClass="card, profiles-panel" maxWidth="Infinity">

                                <VBox spacing="3">
                                    <Label text="Profile Details" styleClass="card-title"/>
                                    <Label text="Edit your profile settings and click behavior." styleClass="muted"/>
                                </VBox>

                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                            hbarPolicy="NEVER" styleClass="profile-scroll">
                                    <content>
                                        <VBox spacing="12" maxWidth="Infinity">

                                            <Label text="Profile Name" styleClass="field-label"/>
                                            <TextField fx:id="profileNameField" styleClass="profile-input"/>

                                            <Label text="Description" styleClass="field-label"/>
                                            <TextArea fx:id="profileDescriptionField"
                                                    prefRowCount="2" wrapText="true"
                                                    styleClass="profile-textarea"/>

                                            <Label text="Hotkey (optional)" styleClass="field-label"/>
                                            <TextField fx:id="profileHotkeyField" promptText="Not set"
                                                    styleClass="profile-input"/>

                                            <Label text="Timing" styleClass="profile-section-title"/>

                                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="profile-detail-row">
                                                <VBox spacing="3">
                                                    <Label text="Fixed  •  100 ms (10 CPS)"
                                                        styleClass="profile-detail-value"/>
                                                    <Label text="Constant delay between clicks." styleClass="muted"/>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button text="Edit" onAction="#handleEditConfiguration"
                                                        styleClass="secondary-button"/>
                                            </HBox>

                                            <Label text="Click Behavior" styleClass="profile-section-title"/>

                                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="profile-detail-row">
                                                <VBox spacing="3">
                                                    <Label text="Left  •  Single  •  Until stopped"
                                                        styleClass="profile-detail-value"/>
                                                    <Label text="Mouse button and repeat settings." styleClass="muted"/>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button text="Edit" onAction="#handleEditConfiguration"
                                                        styleClass="secondary-button"/>
                                            </HBox>

                                            <Label text="Click Target" styleClass="profile-section-title"/>

                                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="profile-detail-row">
                                                <VBox spacing="3">
                                                    <Label text="Follow Cursor" styleClass="profile-detail-value"/>
                                                    <Label text="Click at the current cursor position." styleClass="muted"/>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button text="Edit" onAction="#handleEditConfiguration"
                                                        styleClass="secondary-button"/>
                                            </HBox>

                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <HBox spacing="8" alignment="CENTER_RIGHT">
                                    <Button text="Duplicate" onAction="#handleDuplicateProfile"
                                            styleClass="secondary-button"/>

                                    <Button text="Set Default" onAction="#handleSetDefault"
                                            styleClass="secondary-button"/>

                                    <Button fx:id="deleteProfileButton" text="Delete"
                                            onAction="#handleDeleteProfile"
                                            styleClass="profile-delete-button"/>
                                </HBox>

                                <Button text="Save Changes" maxWidth="Infinity"
                                        onAction="#handleSaveProfile" styleClass="profile-primary-button"/>

                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- SETTINGS PAGE -->
                    <VBox fx:id="settingsPage" spacing="16"
                        visible="false" managed="false" maxWidth="Infinity">

                        <!-- PAGE HEADER -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="3">
                                <Label text="Settings" styleClass="profiles-heading"/>
                                <Label text="Customize the app to fit your workflow." styleClass="muted"/>
                            </VBox>
                        </HBox>

                        <!-- GENERAL + HOTKEYS -->
                        <GridPane hgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" minWidth="0"/>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" minWidth="0"/>
                            </columnConstraints>

                            <!-- GENERAL -->
                            <VBox GridPane.columnIndex="0" spacing="14"
                                maxWidth="Infinity" styleClass="card, settings-card">

                                <VBox spacing="3">
                                    <Label text="General" styleClass="card-title"/>
                                    <Label text="Appearance and general application settings." styleClass="muted"/>
                                </VBox>

                                <!-- ACCENT COLORS -->
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Theme Accent" prefWidth="125" styleClass="field-label"/>

                                    <HBox spacing="9" alignment="CENTER_LEFT">
                                        <ToggleButton fx:id="greenAccent" selected="true"
                                                    toggleGroup="$accentGroup" styleClass="accent-swatch, accent-green"/>

                                        <ToggleButton fx:id="blueAccent"
                                                    toggleGroup="$accentGroup" styleClass="accent-swatch, accent-blue"/>

                                        <ToggleButton fx:id="purpleAccent"
                                                    toggleGroup="$accentGroup" styleClass="accent-swatch, accent-purple"/>

                                        <ToggleButton fx:id="pinkAccent"
                                                    toggleGroup="$accentGroup" styleClass="accent-swatch, accent-pink"/>

                                        <ToggleButton fx:id="orangeAccent"
                                                    toggleGroup="$accentGroup" styleClass="accent-swatch, accent-orange"/>

                                        <ToggleButton fx:id="yellowAccent"
                                                    toggleGroup="$accentGroup" styleClass="accent-swatch, accent-yellow"/>
                                    </HBox>
                                </HBox>

                                <Separator styleClass="settings-separator"/>

                                <!-- LANGUAGE -->
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="Language" prefWidth="125" styleClass="field-label"/>
                                    <ComboBox fx:id="languageCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <!-- UI SCALE -->
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="UI Scale" prefWidth="125" styleClass="field-label"/>
                                    <ComboBox fx:id="uiScaleCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <!-- UPDATES -->
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="Check for Updates" prefWidth="125" styleClass="field-label"/>
                                    <ComboBox fx:id="updateCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <Button text="Check for Updates Now" maxWidth="Infinity"
                                        disable="true" styleClass="secondary-button"/>
                            </VBox>

                            <!-- HOTKEYS -->
                            <VBox GridPane.columnIndex="1" spacing="16"
                                maxWidth="Infinity" styleClass="card, settings-card">

                                <VBox spacing="3">
                                    <Label text="Hotkeys" styleClass="card-title"/>
                                    <Label text="Set global hotkeys for quick access." styleClass="muted"/>
                                </VBox>

                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="Start/Stop Clicking" prefWidth="150" styleClass="field-label"/>

                                    <TextField fx:id="startHotkeyField" editable="false"
                                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                            styleClass="profile-input"/>
                                </HBox>

                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="Next Profile" prefWidth="150" styleClass="field-label"/>

                                    <TextField fx:id="nextProfileHotkeyField" editable="false"
                                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                            styleClass="profile-input"/>
                                </HBox>

                                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="settings-info">
                                    <FontIcon iconLiteral="fth-info" iconSize="19" iconColor="#65bfff"/>
                                    <Label text="Hotkeys work globally, even when the app is in the background."
                                        wrapText="true" styleClass="muted"/>
                                </HBox>
                            </VBox>
                        </GridPane>


                        <!-- STARTUP & WINDOW -->
                        <VBox spacing="14" styleClass="card, settings-card">

                            <VBox spacing="3">
                                <Label text="Startup &amp; Window" styleClass="card-title"/>
                                <Label text="Control how the application starts and behaves." styleClass="muted"/>
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="16">
